<section class="container slider-container">
  <div class="slider-track">
    <div class="text-field slide" id="field-1">
      <h1>{{ section.settings.ingredients_text }}</h1>
    </div>
    <div class="text-field slide" id="field-2">
      <h1>{{ section.settings.nature_text }}</h1>
    </div>
    <div class="text-field slide" id="field-3">
      <h1>{{ section.settings.radiance_text }}</h1>
    </div>
  </div>
</section>

<style>
    .slider-container {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    .slider-track {
        display: flex;
        height: 100%;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: grab;
    }

    .slider-track.grabbing {
        cursor: grabbing;
    }

    .slide {
        flex: 0 0 100%;
        min-width: 100%;
        opacity: 0.3;
        transition: opacity 0.3s;
        position: relative;
    }

    .slide.active {
        opacity: 1;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sliderTrack = document.querySelector('.slider-track');
        const slides = document.querySelectorAll('.slide');
        let currentIndex = 0;
        let lastScrollY = window.scrollY;
        let scrollDelta = 0;

        // 滚动事件监听
        window.addEventListener('scroll', () => {
            const currentScrollY = window.scrollY;
            const direction = currentScrollY > lastScrollY ? 1 : -1;

            // 计算滚动距离差值
            scrollDelta += Math.abs(currentScrollY - lastScrollY);

            // 当累计滚动超过100px时切换幻灯片
            if (scrollDelta > 100) {
                const newIndex = Math.max(0, Math.min(currentIndex + direction, slides.length - 1));

                if (newIndex !== currentIndex) {
                    currentIndex = newIndex;
                    updateSlider();
                }

                scrollDelta = 0; // 重置累计值
            }

            lastScrollY = currentScrollY;
        });

        const updateSlider = () => {
            slides.forEach((slide, index) => {
                slide.classList.toggle('active', index === currentIndex);
            });
            sliderTrack.style.transform = `translateX(-${currentIndex * 100}%)`;
        };

        // 初始化
        updateSlider();
    });
</script>

{% schema %}
{
  "name": "Parallax",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "ingredients_text",
      "label": "Text1",
      "default": "Gentle yet effective ingredients."
    },
    {
      "type": "text",
      "id": "nature_text",
      "label": "Text2",
      "default": "Vitally drawn from nature's depth."
    },
    {
      "type": "text",
      "id": "radiance_text",
      "label": "Text3",
      "default": "Find your radiance with ease."
    }
  ],
  "presets": [
    {
      "name": "Parallax"
    }
  ]
}
{% endschema %}
